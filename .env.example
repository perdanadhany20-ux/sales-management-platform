# ─── Supabase ────────────────────────────────────────────────────────────────
# URL project dan anon key: aman tampil di browser (dilindungi RLS).
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# HANYA server. Melewati seluruh RLS — jangan pernah diawali NEXT_PUBLIC_
# dan jangan pernah di-commit (§51, §95).
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Rahasia penanda tangan JWT project (Supabase Dashboard → Settings → API →
# JWT Secret). Dipakai lib/db-token.ts untuk menerbitkan token PostgREST
# milik user yang login, supaya policy RLS bisa membaca identitasnya.
# Tanpa ini aplikasi tetap jalan, tapi semua query berangkat sebagai anon.
SUPABASE_JWT_SECRET=

# ─── Aplikasi ────────────────────────────────────────────────────────────────
# URL publik, dipakai tautan pada notifikasi.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Lisensi (LICENSE_ARCHITECTURE.md) ───────────────────────────────────────
# OPSIONAL. Cara biasa: Admin pelanggan menempel Kode Aktivasi di Admin → Lisensi
# (alamat & kunci publik Kantor Pusat sudah bawaan kode). Isi variabel di bawah
# hanya bila developer ingin mengatur lisensi deployment ini langsung — bila
# LICENSE_DEPLOYMENT_ID, LICENSE_ID, dan LICENSE_DEPLOYMENT_KEY terisi, ketiganya
# menang atas Kode Aktivasi. SERVER-ONLY — jangan pernah diawali NEXT_PUBLIC_.
LICENSE_AUTHORITY_URL=https://license.example.com
LICENSE_DEPLOYMENT_ID=SMA-ABC-2026-001
LICENSE_ID=LIC-SMA-2026-0001
# Kunci deployment (ditampilkan sekali saat registrasi). Pusat hanya menyimpan hash-nya.
LICENSE_DEPLOYMENT_KEY=
# Kunci PUBLIK Ed25519 License Authority (aman dibagikan; tidak bisa dipakai memalsukan lisensi).
LICENSE_PUBLIC_KEY=
# `development` hanya berlaku saat `next dev` — build produksi selalu mengabaikannya.
LICENSE_MODE=production
# Rahasia Vercel Cron untuk /api/lisensi/cron & /api/push/cron (min. 16 karakter).
CRON_SECRET=

# ─── Notifikasi push — opsional (npm run vapid) ─────────────────────────────
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@perusahaan-anda.co.id

# ─── 2FA — opsional; kosong = diturunkan dari SUPABASE_JWT_SECRET ───────────
MFA_ENCRYPTION_KEY=

# ─── Aplikasi Android (android/README.md) — opsional ─────────────────────────
ANDROID_PACKAGE_ID=
ANDROID_CERT_SHA256=
