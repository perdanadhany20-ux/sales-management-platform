# ─── Supabase ────────────────────────────────────────────────────────────────
# URL project dan anon key: aman tampil di browser (dilindungi RLS).
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# HANYA server. Melewati seluruh RLS — jangan pernah diawali NEXT_PUBLIC_
# dan jangan pernah di-commit (§51, §95).
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Rahasia penanda tangan JWT project (Supabase Dashboard → Settings → API →
# JWT Secret). Dipakai lib/db-token.ts untuk menerbitkan token PostgREST
# milik user yang login, supaya policy RLS bisa membaca identitasnya.
# Tanpa ini aplikasi tetap jalan, tapi semua query berangkat sebagai anon.
SUPABASE_JWT_SECRET=

# ─── Aplikasi ────────────────────────────────────────────────────────────────
# URL publik, dipakai tautan pada notifikasi.
NEXT_PUBLIC_APP_URL=http://localhost:3000
