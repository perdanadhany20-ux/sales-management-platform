# ─── License Authority pusat (proyek Vercel + Supabase MILIK DEVELOPER) ──────
# Seluruh nilai di sini SERVER-ONLY. Tidak ada satu pun yang boleh diawali
# NEXT_PUBLIC_, dan tidak ada satu pun yang dipasang di deployment pelanggan
# (kecuali kunci PUBLIK, yang memang aman dibagikan).

# Supabase PUSAT (bukan Supabase pelanggan). Jalankan supabase/migrations/001_*.sql di sana.
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Kunci privat Ed25519 penanda tangan token lisensi (DER pkcs8 base64 atau PEM).
# Buat dengan: npm run keys  — pasangan publiknya dipasang di tiap deployment
# pelanggan sebagai LICENSE_PUBLIC_KEY.
LICENSE_PRIVATE_KEY=

# Bot Telegram (@BotFather) dan ID pengguna Telegram developer yang BOLEH
# bertindak (angka, bukan username; pisahkan dengan koma bila lebih dari satu).
TELEGRAM_BOT_TOKEN=
TELEGRAM_DEVELOPER_ID=
# Rahasia acak ≥ 32 karakter; didaftarkan ke Telegram saat setWebhook
# (secret_token) dan dicocokkan di setiap update yang masuk.
TELEGRAM_WEBHOOK_SECRET=

# Kata sandi dashboard web (Basic Auth, pengguna: developer). ≥ 24 karakter.
CENTRAL_ADMIN_SECRET=

# Rahasia Vercel Cron untuk /api/cron (peringatan kedaluwarsa harian).
CRON_SECRET=
